# ====================================================================
# Afreqa Website — Environment Configuration Template
# ====================================================================

# ----------------------------------------------------
# 1. RUNTIME & PORTS
# ----------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ----------------------------------------------------
# 2. DATABASE & ROLES
# ----------------------------------------------------
# PostgreSQL database credentials for container initialization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=afreqa_dev_password
POSTGRES_DB=afreqa_db
POSTGRES_PORT=5433

# Runtime connection for the Next.js app & worker (Restricted App DB Role)
# When running outside Docker on the host, use localhost:5433 (mapped from container)
DATABASE_URL=postgresql://afreqa_app:afreqa_app_dev_password@localhost:5433/afreqa_db

# Migration connection for Prisma CLI migrations (Owner Role)
DATABASE_OWNER_URL=postgresql://postgres:afreqa_dev_password@localhost:5433/afreqa_db

# ----------------------------------------------------
# 3. SUPER ADMIN SEEDING
# ----------------------------------------------------
# Seeded with `mustChangePassword: true` on first login.
# In production, seeding will throw a fatal error if either variable is unset.
SEED_ADMIN_EMAIL=admin@afreqa.local
SEED_ADMIN_PASSWORD=AfreqaAdmin2026!

# ----------------------------------------------------
# 4. SHOWCASE DEMO MODE
# ----------------------------------------------------
# When true, seeds the merch shop as enabled with clearly fake sample merch.
# Production default is strictly false (shop hidden behind feature flag).
DEMO_MODE=true

# ----------------------------------------------------
# 5. SECURITY & SESSIONS
# ----------------------------------------------------
# Cryptographic secret for signing session tokens and cookies (min 32 characters)
SESSION_SECRET=dev-session-secret-must-be-changed-in-production-min-32-chars!

# ----------------------------------------------------
# 6. MEDIA STORAGE
# ----------------------------------------------------
STORAGE_UPLOAD_DIR=./uploads
STORAGE_PUBLIC_URL_PREFIX=/uploads

# ----------------------------------------------------
# 7. HYBRID TICKETING & WHATSAPP
# ----------------------------------------------------
HUSTLESASA_STORE_URL=https://afreqanairobi.hustlesasa.shop/

# ----------------------------------------------------
# 8. EMAIL (SMTP & QUEUE)
# ----------------------------------------------------
# In development, Mailpit catches all SMTP traffic on port 1025 with web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Afreqa Nairobi <hello@afreqa.com>

# ----------------------------------------------------
# 9. PAYMENTS (PHASE 5 — MERCH SHOP)
# ----------------------------------------------------
# In dev/demo, MockProvider is used by default with zero external accounts.
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# ----------------------------------------------------
# 10. ANALYTICS (OPTIONAL UMAMI PROFILE)
# ----------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

