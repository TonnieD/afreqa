# ====================================================================
# Afreqa Website — Environment Configuration Template
# ====================================================================

# ----------------------------------------------------
# 1. RUNTIME & PORTS
# ----------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ----------------------------------------------------
# 2. DATABASE & ROLES
# ----------------------------------------------------
# PostgreSQL database credentials for container initialization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=afreqa_dev_password
POSTGRES_DB=afreqa_db
POSTGRES_PORT=5433

# Runtime connection for the Next.js app (Restricted afreqa_app role)
# On Neon, use the POOLED endpoint with ?sslmode=require&pgbouncer=true&connect_timeout=10
DATABASE_URL=postgresql://afreqa_app:afreqa_app_dev_password@localhost:5433/afreqa_db

# Direct owner connection for Prisma CLI migrations & `queue:init` / `create-admin` (afreqa_owner role)
# On Neon, use the DIRECT (non-pooled) endpoint with ?sslmode=require&connect_timeout=15
DIRECT_URL=postgresql://afreqa_owner:afreqa_owner_dev_password@localhost:5433/afreqa_db

# Optional alias for Docker/local owner migrations
DATABASE_OWNER_URL=postgresql://afreqa_owner:afreqa_owner_dev_password@localhost:5433/afreqa_db

# ----------------------------------------------------
# 3. SUPER ADMIN SEEDING
# ----------------------------------------------------
# Seeded with `mustChangePassword: true` on first login.
# In production, seeding will throw a fatal error if either variable is unset.
SEED_ADMIN_EMAIL=admin@afreqa.local
SEED_ADMIN_PASSWORD=AfreqaAdmin2026!

# ----------------------------------------------------
# 4. SHOWCASE DEMO MODE & REVIEW CONTROLS
# ----------------------------------------------------
# Keep DEMO_MODE=false so the merch shop stays parked/disabled.
# Use DEMO_BANNER and ROBOTS_NOINDEX to control preview notices and search indexing.
DEMO_MODE=false
DEMO_BANNER=true
DEMO_CONTENT_UNVERIFIED=true
ROBOTS_NOINDEX=true
VIDEO_UPLOAD_ENABLED=false

# ----------------------------------------------------
# 5. SECURITY & SESSIONS
# ----------------------------------------------------
# Cryptographic secret for signing session tokens and cookies (min 32 characters)
SESSION_SECRET=dev-session-secret-must-be-changed-in-production-min-32-chars!

# ----------------------------------------------------
# 6. MEDIA STORAGE
# ----------------------------------------------------
# Supported drivers: local | vercel-blob | r2 (demo uses vercel-blob; local for dev)
STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=./uploads
STORAGE_PUBLIC_URL_PREFIX=/uploads
# Required when STORAGE_DRIVER=vercel-blob (set in Vercel project env vars)
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=
# Demo photo cap (admin UI warns at >=80%, blocks at 100%)
GALLERY_MAX_PHOTOS=100

# ----------------------------------------------------
# 7. HYBRID TICKETING & WHATSAPP
# ----------------------------------------------------
HUSTLESASA_STORE_URL=https://afreqamusicfestival.hustlesasa.shop/
WHATSAPP_PHONE=+254743836164

# ----------------------------------------------------
# 8. EMAIL (SMTP & QUEUE) & SCHEDULER
# ----------------------------------------------------
# In development, Mailpit catches all SMTP traffic on port 1025 with web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Afreqa Nairobi <hello@afreqa.com>
ADMIN_NOTIFY_EMAIL=
# Optional comma-separated recipient allow-list for demo deployments (e.g. you@example.com)
EMAIL_ALLOWLIST=
# Secret header token protecting the host-agnostic /api/internal/cron queue-drain & cleanup endpoint
CRON_SECRET=dev-cron-secret-change-in-production

# ----------------------------------------------------
# 9. ANALYTICS (OPTIONAL UMAMI PROFILE)
# ----------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ----------------------------------------------------
# 11. EVENT PHOTO VAULT
# ----------------------------------------------------
NEXT_PUBLIC_HALLOWEEN_PHOTOS_URL=https://drive.google.com/drive/folders/1EKHSU4PsGTeNACb7GM6ST-mGbslRuiKA

