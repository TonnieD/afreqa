{
  "name": "@afreqa/core",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm db:generate && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:seed": "tsx ./prisma/seed.ts",
    "create-admin": "tsx ./src/cli/create-admin.ts",
    "queue:init": "tsx ./src/cli/init-queue.ts",
    "audit:lock": "tsx ./src/cli/audit-lock.ts",
    "db:deploy": "pnpm db:migrate && pnpm queue:init && pnpm audit:lock",
    "neon:verify": "tsx ./src/cli/verify-neon.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@vercel/blob": "^2.9.0",
    "libphonenumber-js": "^1.11.18",
    "nodemailer": "^6.9.16",
    "pg-boss": "^10.1.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
