# ---------------------------------------------------
# Multi-stage Dockerfile for Next.js Web Application
# ---------------------------------------------------

FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN apk add --no-cache libc6-compat openssl
RUN corepack enable
RUN corepack prepare pnpm@10.5.2 --activate

# 1. Dependencies Stage
FROM base AS deps
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/core/package.json ./packages/core/
COPY apps/web/package.json ./apps/web/
COPY worker/package.json ./worker/
RUN pnpm install --frozen-lockfile

# 2. Builder Stage
FROM deps AS builder
WORKDIR /app
COPY . .
RUN mkdir -p apps/web/public

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_ENV_VALIDATION=1
ENV BUILD_STANDALONE=true

# Generate Prisma Client & Build Core Package
RUN pnpm --filter @afreqa/core db:generate
RUN pnpm --filter @afreqa/core build

# Build Next.js Web App
RUN pnpm --filter @afreqa/web build

# Copy Prisma query engine into Next.js standalone package
RUN mkdir -p apps/web/.next/standalone/apps/web/.prisma/client && \
    find node_modules -name "libquery_engine-linux-musl-openssl-3.0.x.so.node" -exec cp {} apps/web/.next/standalone/apps/web/.prisma/client/ \; 2>/dev/null || true

# 3. Production Runner Stage
FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV PRISMA_QUERY_ENGINE_LIBRARY=/app/apps/web/.prisma/client/libquery_engine-linux-musl-openssl-3.0.x.so.node

# Non-root security user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Create uploads directory and grant permissions
RUN mkdir -p /app/uploads && chown -R nextjs:nodejs /app/uploads

# Copy public, standalone, dependencies & prisma assets from builder
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/packages/core/prisma ./packages/core/prisma

USER nextjs

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
